{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": ".",
      "framework": "express",
      "buildCommand": "npm install",
      "functions": {
        "api/*.js": {
          "runtime": "nodejs20.x"
        }
      },
      "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/[...path]" }
      ]
    }
  }
}
