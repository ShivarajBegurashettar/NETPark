# NETPark API Server Environment Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Connection URI
# Local MongoDB: mongodb://localhost:27017/netpark
# Cloud MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/netpark
MONGO_URI=mongodb://localhost:27017/netpark

# Authentication Security (Generate a secure random string)
JWT_SECRET=your_super_strong_jwt_secret_here

# Master Administrator Setup
MASTER_ADMIN_EMAIL=admin@netpark.local
MASTER_ADMIN_PASSWORD=your_secure_master_password_here

# Email SMTP Configuration (Gmail)
# Obtain a 16-letter App Password from https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password